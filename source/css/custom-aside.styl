/* ============================================
 * 批次2：侧边栏组件
 * 1. 个人卡片升级（状态徽章 + 统计）
 * 2. GitHub 仓库卡片
 * 3. 农历日历
 * 4. 在线人数/访客统计
 * 5. 即时搜索
 * 6. 侧边栏音乐播放器
 * 7. 一言/网易云热评
 * ============================================ */

#aside-content .card-widget {
  margin-bottom: 1rem;
  overflow: hidden;
}

/* ===== 1. 个人卡片 ===== */
#aside-content .card-info {
  position: relative;
}
.author-status {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  font-size: .75rem;
  padding: .15rem .6rem;
  margin: .5rem 0;
  border-radius: 999px;
  background: rgba(73, 177, 245, .08);
  color: #49b1f5;
  border: 1px solid rgba(73, 177, 245, .2);
}
[data-theme="dark"] .author-status {
  background: rgba(107, 192, 247, .12);
  color: #8fd0fa;
  border-color: rgba(107, 192, 247, .25);
}
.author-status .status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #5a9e6f;
  animation: status-pulse 2s ease-in-out infinite;
}
@keyframes status-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: .3; }
}
.author-stats {
  display: flex;
  justify-content: space-around;
  margin-top: .8rem;
  padding-top: .8rem;
  border-top: 1px dashed rgba(73, 177, 245, .2);
}
[data-theme="dark"] .author-stats {
  border-top-color: rgba(107, 192, 247, .2);
}
.author-stats .stat-item {
  text-align: center;
}
.author-stats .stat-num {
  display: block;
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--theme-color);
}
.author-stats .stat-label {
  font-size: .7rem;
  opacity: .65;
}

/* ===== 2. GitHub 卡片 ===== */
.card-github {
  padding: 1rem;
}
.card-github .gh-header {
  display: flex;
  align-items: center;
  gap: .6rem;
  margin-bottom: .8rem;
}
.card-github .gh-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid rgba(73, 177, 245, .3);
}
.card-github .gh-name {
  font-weight: 700;
  font-size: .9rem;
}
.card-github .gh-bio {
  font-size: .75rem;
  opacity: .7;
}
.gh-repo {
  display: block;
  padding: .5rem .6rem;
  margin-bottom: .4rem;
  border-radius: .5rem;
  border: 1px solid rgba(73, 177, 245, .15);
  background: rgba(73, 177, 245, .03);
  text-decoration: none !important;
  transition: all .25s ease;
}
.gh-repo:hover {
  border-color: rgba(73, 177, 245, .4);
  background: rgba(73, 177, 245, .08);
  transform: translateX(3px);
}
[data-theme="dark"] .gh-repo {
  border-color: rgba(107, 192, 247, .15);
  background: rgba(107, 192, 247, .04);
}
[data-theme="dark"] .gh-repo:hover {
  border-color: rgba(107, 192, 247, .4);
  background: rgba(107, 192, 247, .1);
}
.gh-repo-name {
  font-weight: 600;
  font-size: .8rem;
  color: var(--theme-color);
}
.gh-repo-desc {
  font-size: .7rem;
  opacity: .65;
  margin-top: .15rem;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.gh-repo-stars {
  font-size: .7rem;
  opacity: .6;
  margin-top: .2rem;
}

/* ===== 3. 农历日历 ===== */
.card-lunar {
  padding: 1rem;
  text-align: center;
}
.lunar-date {
  font-family: "Noto Serif SC", "Songti SC", serif;
}
.lunar-gregorian {
  font-size: .75rem;
  opacity: .65;
  margin-bottom: .5rem;
}
.lunar-day {
  font-size: 2.2rem;
  font-weight: 700;
  color: var(--theme-color);
  line-height: 1.2;
}
.lunar-month {
  font-size: .9rem;
  letter-spacing: .1em;
  margin-top: .2rem;
}
.lunar-jieqi {
  display: inline-block;
  margin-top: .6rem;
  padding: .15rem .8rem;
  font-size: .75rem;
  border-radius: 999px;
  background: rgba(73, 177, 245, .08);
  color: var(--theme-color);
  border: 1px solid rgba(73, 177, 245, .2);
}
[data-theme="dark"] .lunar-jieqi {
  background: rgba(107, 192, 247, .12);
  border-color: rgba(107, 192, 247, .25);
}

/* ===== 4. 在线统计 ===== */
.card-online {
  padding: .8rem 1rem;
}
.online-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: .3rem 0;
  font-size: .8rem;
}
.online-row + .online-row {
  border-top: 1px dashed rgba(73, 177, 245, .12);
}
[data-theme="dark"] .online-row + .online-row {
  border-top-color: rgba(107, 192, 247, .12);
}
.online-num {
  font-weight: 700;
  color: var(--theme-color);
}

/* ===== 5. 即时搜索 ===== */
.card-search {
  padding: .8rem 1rem;
}
.card-search input {
  width: 100%;
  padding: .45rem .7rem;
  border: 1px solid rgba(73, 177, 245, .25);
  border-radius: .5rem;
  background: transparent;
  color: var(--font-color);
  font-size: .8rem;
  outline: none;
  transition: border-color .25s;
}
.card-search input:focus {
  border-color: var(--theme-color);
}
.card-search input::placeholder {
  opacity: .5;
}
.search-results {
  margin-top: .5rem;
  max-height: 200px;
  overflow-y: auto;
}
.search-result-item {
  display: block;
  padding: .35rem .5rem;
  font-size: .75rem;
  border-radius: .35rem;
  text-decoration: none !important;
  color: var(--font-color);
  border-left: 2px solid transparent;
  transition: all .2s;
}
.search-result-item:hover {
  background: rgba(73, 177, 245, .07);
  border-left-color: var(--theme-color);
}
[data-theme="dark"] .search-result-item:hover {
  background: rgba(107, 192, 247, .1);
}
.search-empty {
  font-size: .72rem;
  opacity: .5;
  padding: .3rem .5rem;
}

/* ===== 6. fixed 播放器：彻底隐藏全宽歌词层（防遮挡页脚）===== */
body > meting-js .aplayer-lrc,
.aplayer-lrc {
  display: none !important;
}
body > meting-js {
  z-index: 998 !important;
}
/* 列表默认收起，点击才展开 */
.aplayer-list {
  max-height: 240px;
}

/* ===== 侧边栏音乐播放器（若启用）===== */
#aside-content .aplayer {
  margin: 0;
  box-shadow: none;
  border: 1px solid rgba(73, 177, 245, .15);
  border-radius: .8rem;
  background: #fff !important;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif !important;
}
[data-theme="dark"] #aside-content .aplayer {
  background: #121212 !important;
  border-color: rgba(107, 192, 247, .15);
}

/* ===== 7. 一言 ===== */
.card-yiyan {
  padding: 1rem;
  text-align: center;
}
.yiyan-text {
  font-family: "Noto Serif SC", "Songti SC", serif;
  font-size: .85rem;
  line-height: 1.8;
  min-height: 3.6rem;
  display: flex;
  align-items: center;
  justify-content: center;
}
.yiyan-from {
  font-size: .7rem;
  opacity: .55;
  margin-top: .5rem;
}
.yiyan-refresh {
  margin-top: .6rem;
  padding: .25rem .9rem;
  font-size: .7rem;
  border-radius: 999px;
  border: 1px solid rgba(73, 177, 245, .3);
  background: transparent;
  color: var(--theme-color);
  cursor: pointer;
  transition: all .25s;
}
.yiyan-refresh:hover {
  background: rgba(73, 177, 245, .08);
}
[data-theme="dark"] .yiyan-refresh {
  border-color: rgba(107, 192, 247, .3);
}
[data-theme="dark"] .yiyan-refresh:hover {
  background: rgba(107, 192, 247, .1);
}

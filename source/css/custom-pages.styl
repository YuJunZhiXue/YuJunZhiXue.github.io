/* ============================================
 * 批次5：新页面样式
 * 1. 说说（时间流）
 * 2. 相册瀑布流
 * 3. 留言板
 * 4. 项目展示页
 * 5. 书单影单
 * ============================================ */

/* ===== 1. 说说 ===== */
/* ===== 1. 说说 · 卷轴手札 ===== */
.shuoshuo-list {
  max-width: 760px;
  margin: 0 auto;
  padding: 1rem 0 3rem;
}
.ss-item {
  position: relative;
  padding: 1.25rem 1.6rem 1.15rem;
  margin-bottom: 1.4rem;
  border-radius: .45rem;
  background: var(--paper);
  border: 1px solid rgba(90, 74, 58, .16);
  border-left: 4px solid #a8351f;
  box-shadow: 2px 4px 14px rgba(60, 45, 30, .07);
  transition: transform .25s ease, box-shadow .25s ease;
  overflow: hidden;
}
.ss-item:hover {
  transform: translateY(-2px);
  box-shadow: 3px 10px 22px rgba(60, 45, 30, .12);
}
/* 右上角淡印 */
.ss-item::after {
  content: "\201C";
  position: absolute;
  right: .7rem;
  top: -.5rem;
  font-size: 4.2rem;
  line-height: 1;
  color: rgba(168, 53, 31, .1);
  font-family: "Noto Serif SC", serif;
  pointer-events: none;
}
[data-theme="dark"] .ss-item {
  background: var(--paper);
  border-color: rgba(200, 180, 160, .14);
  border-left-color: #c14e33;
  box-shadow: 2px 4px 14px rgba(0, 0, 0, .35);
}
[data-theme="dark"] .ss-item::after {
  color: rgba(193, 78, 51, .16);
}
/* 日期印章 */
.ss-time {
  display: inline-block;
  font-size: .72rem;
  letter-spacing: .14em;
  color: #fdf8f0;
  background: #a8351f;
  border-radius: .28rem;
  padding: .22rem .65rem .22rem .79rem;
  margin-bottom: .65rem;
  font-family: "Noto Serif SC", serif;
  box-shadow: 1px 2px 6px rgba(142, 43, 22, .3);
  opacity: 1;
}
.ss-content {
  font-size: .95rem;
  line-height: 2.05;
  color: var(--font-color);
  font-family: "Noto Serif SC", serif;
  text-align: justify;
  letter-spacing: .02em;
}
.ss-content img {
  max-width: 100%;
  border-radius: .5rem;
  margin-top: .6rem;
}

/* ===== 2. 相册瀑布流 ===== */
.gallery-wall {
  max-width: 1000px;
  margin: 0 auto;
  padding: 1rem 0 2rem;
  columns: 3;
  column-gap: 1rem;
}
@media (max-width: 900px) {
  .gallery-wall { columns: 2; }
}
@media (max-width: 560px) {
  .gallery-wall { columns: 1; }
}
.gallery-item {
  break-inside: avoid;
  margin-bottom: 1rem;
  border-radius: .8rem;
  overflow: hidden;
  border: 1px solid rgba(73, 177, 245, .15);
  background: var(--paper);
  cursor: zoom-in;
  transition: all .3s ease;
}
.gallery-item:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 26px -12px rgba(7, 17, 27, .035);
}
[data-theme="dark"] .gallery-item {
  background: var(--paper);
  border-color: rgba(107, 192, 247, .15);
}
.gallery-item img {
  width: 100%;
  display: block;
  transition: transform .5s;
}
.gallery-item:hover img {
  transform: scale(1.04);
}
.gallery-caption {
  padding: .5rem .7rem;
  font-size: .75rem;
  opacity: .7;
  text-align: center;
  font-family: "Noto Serif SC", serif;
}

/* ===== 3. 留言板 ===== */
.message-board {
  max-width: 760px;
  margin: 0 auto;
  padding: 1rem 0 2rem;
}
.message-form textarea {
  width: 100%;
  min-height: 90px;
  padding: .7rem .9rem;
  border-radius: .7rem;
  border: 1px solid rgba(73, 177, 245, .25);
  background: var(--paper);
  color: var(--font-color);
  font-family: "Noto Serif SC", serif;
  font-size: .9rem;
  resize: vertical;
  outline: none;
  transition: border-color .25s;
}
.message-form textarea:focus {
  border-color: var(--theme-color);
}
[data-theme="dark"] .message-form textarea {
  background: var(--paper);
  border-color: rgba(107, 192, 247, .25);
}
.message-form .msg-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: .6rem;
}
.message-form .msg-name {
  flex: 1;
  margin-right: .8rem;
  padding: .4rem .7rem;
  border-radius: .5rem;
  border: 1px solid rgba(73, 177, 245, .2);
  background: transparent;
  color: var(--font-color);
  font-size: .8rem;
  outline: none;
}
[data-theme="dark"] .message-form .msg-name {
  border-color: rgba(107, 192, 247, .2);
}
.msg-send {
  padding: .45rem 1.4rem;
  border-radius: 999px;
  border: 1px solid var(--theme-color);
  background: rgba(73, 177, 245, .08);
  color: var(--theme-color);
  font-size: .8rem;
  cursor: pointer;
  transition: all .25s;
}
.msg-send:hover {
  background: var(--theme-color);
  color: #fff;
}
[data-theme="dark"] .msg-send:hover {
  background: #6bc0f7;
  color: #1a1714;
}
.message-list {
  margin-top: 1.5rem;
}
.msg-item {
  padding: .9rem 1.1rem;
  margin-bottom: .8rem;
  border-radius: .7rem;
  border: 1px solid rgba(73, 177, 245, .12);
  background: var(--paper);
  animation: msg-appear .35s ease;
}
@keyframes msg-appear {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: none; }
}
[data-theme="dark"] .msg-item {
  background: var(--paper);
  border-color: rgba(107, 192, 247, .12);
}
.msg-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: .4rem;
}
.msg-author {
  font-weight: 700;
  font-size: .82rem;
  color: var(--theme-color);
}
.msg-date {
  font-size: .68rem;
  opacity: .5;
}
.msg-body {
  font-size: .86rem;
  line-height: 1.8;
  word-wrap: break-word;
}
.msg-empty {
  text-align: center;
  padding: 2rem 0;
  opacity: .5;
  font-size: .85rem;
  font-family: "Noto Serif SC", serif;
}

/* ===== 4. 项目展示页 ===== */
.project-grid {
  max-width: 1000px;
  margin: 0 auto;
  padding: 1rem 0 2rem;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.2rem;
}
.project-card {
  border-radius: 1rem;
  border: 1px solid rgba(73, 177, 245, .15);
  background: var(--paper);
  overflow: hidden;
  transition: all .3s cubic-bezier(.4, 0, .2, 1);
}
.project-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 32px -12px rgba(7, 17, 27, .03);
  border-color: rgba(73, 177, 245, .35);
}
[data-theme="dark"] .project-card {
  background: var(--paper);
  border-color: rgba(107, 192, 247, .15);
}
[data-theme="dark"] .project-card:hover {
  border-color: rgba(107, 192, 247, .35);
}
.project-thumb {
  width: 100%;
  height: 140px;
  object-fit: cover;
  display: block;
  background: rgba(73, 177, 245, .06);
}
.project-body {
  padding: .9rem 1.1rem 1.1rem;
}
.project-name {
  font-size: 1rem;
  font-weight: 700;
  font-family: "Noto Serif SC", serif;
  margin-bottom: .35rem;
}
.project-name a {
  color: var(--font-color) !important;
  text-decoration: none !important;
}
.project-name a:hover {
  color: var(--theme-color) !important;
}
.project-desc {
  font-size: .8rem;
  line-height: 1.7;
  opacity: .75;
  margin-bottom: .6rem;
}
.project-tags {
  display: flex;
  flex-wrap: wrap;
  gap: .35rem;
}
.project-tag {
  font-size: .68rem;
  padding: .12rem .55rem;
  border-radius: 999px;
  background: rgba(73, 177, 245, .08);
  color: var(--theme-color);
  border: 1px solid rgba(73, 177, 245, .2);
}
[data-theme="dark"] .project-tag {
  background: rgba(107, 192, 247, .1);
  border-color: rgba(107, 192, 247, .25);
}

/* ===== 5. 书单影单 ===== */
.media-tabs {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
  margin-bottom: 1.5rem;
}
.media-tab {
  display: inline-block;
  padding: .4rem 1.4rem;
  margin: 0 .3rem;
  font-size: .85rem;
  border-radius: 999px;
  border: 1px solid rgba(73, 177, 245, .25);
  background: transparent;
  color: var(--font-color);
  cursor: pointer;
  transition: all .25s;
  font-family: "Noto Serif SC", serif;
}
.media-tab.active {
  background: var(--theme-color);
  color: #fff;
  border-color: var(--theme-color);
}
.media-tab:not(.active):hover {
  background: rgba(73, 177, 245, .08);
}
[data-theme="dark"] .media-tab:not(.active):hover {
  background: rgba(107, 192, 247, .1);
}
.media-list {
  max-width: 900px;
  margin: 0 auto;
  padding: 0 0 2rem;
}
.media-item {
  display: flex;
  gap: 1rem;
  padding: 1rem;
  margin-bottom: .9rem;
  border-radius: .8rem;
  border: 1px solid rgba(73, 177, 245, .12);
  background: var(--paper);
  transition: all .25s;
}
.media-item:hover {
  box-shadow: 0 8px 20px -10px rgba(7, 17, 27, .025);
}
[data-theme="dark"] .media-item {
  background: var(--paper);
  border-color: rgba(107, 192, 247, .12);
}
.media-cover {
  flex: none;
  width: 72px;
  height: 96px;
  border-radius: .4rem;
  object-fit: cover;
  background: rgba(73, 177, 245, .06);
}
.media-info {
  flex: 1;
  min-width: 0;
}
.media-title {
  font-size: .92rem;
  font-weight: 700;
  font-family: "Noto Serif SC", serif;
}
.media-meta {
  font-size: .72rem;
  opacity: .6;
  margin: .15rem 0 .4rem;
}
.media-note {
  font-size: .78rem;
  line-height: 1.7;
  opacity: .8;
}
@media (max-width: 560px) {
  .media-item {
    flex-direction: column;
  }
  .media-cover {
    width: 100%;
    height: 130px;
  }
}

/* ===== 6. 工具箱 ===== */
.tools-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.2rem;
  padding: 1rem 0 3rem;
}
.tool-card {
  background: var(--paper);
  border: 1px solid rgba(90, 74, 58, .16);
  border-top: 3px solid #a8351f;
  border-radius: .45rem;
  box-shadow: 2px 4px 14px rgba(60, 45, 30, .07);
  padding: 1.1rem 1.2rem 1.2rem;
}
.tool-card h3 {
  margin: 0 0 .8rem;
  font-size: 1.05rem;
  color: #a8351f;
  border-bottom: 1px dashed rgba(168, 53, 31, .3);
  padding-bottom: .5rem;
}
.tool-card input, .tool-card textarea, .tool-card select {
  width: 100%;
  box-sizing: border-box;
  margin-bottom: .6rem;
  padding: .5rem .6rem;
  border: 1px solid rgba(90, 74, 58, .3);
  border-radius: .3rem;
  background: rgba(255, 255, 255, .6);
  font-size: .9rem;
  font-family: inherit;
  color: inherit;
}
.tool-card textarea { resize: vertical; }
.tool-row {
  display: flex;
  gap: .5rem;
  flex-wrap: wrap;
  margin-bottom: .6rem;
  align-items: center;
}
.tool-row label { font-size: .85rem; display: flex; align-items: center; gap: .25rem; }
.tool-row label input { width: auto; margin: 0; }
.tool-checks label input { width: auto; }
#pw-len { width: 4.5rem; }
.tool-card button {
  padding: .45rem 1rem;
  border: 1px solid #a8351f;
  border-radius: .3rem;
  background: transparent;
  color: #a8351f;
  cursor: pointer;
  font-size: .85rem;
  transition: all .2s;
}
.tool-card button:hover { background: #a8351f; color: #fff; }
.tool-out {
  min-height: 1.2rem;
  padding: .6rem .7rem;
  background: rgba(90, 74, 58, .06);
  border-radius: .3rem;
  font-size: .85rem;
  white-space: pre-wrap;
  word-break: break-all;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: .5rem;
}
.tool-out:empty { display: none; }
.tool-out button { flex-shrink: 0; padding: .2rem .6rem; font-size: .75rem; }

/* ===== 7. 人生重开 ===== */
.relife-wrap {
  padding: 1rem 0 3rem;
}
.relife-wrap iframe {
  width: 100%;
  height: 85vh;
  min-height: 600px;
  border: 2px solid rgba(168, 53, 31, .4);
  border-radius: .5rem;
  box-shadow: 2px 4px 18px rgba(60, 45, 30, .12);
  background: #fff;
}

/* ============================================
 * 仿 onektas.top 设计语言重写
 * 纯白底 + 蓝主题色 #49b1f5 + 无边框阴影卡片
 * 保留古风骨架（宋体标题/节气/朱砂点缀仅在必要时）
 * ============================================ */

/* ============ 色板：onektas 实采 ============ */
:root {
  --card-bg: #ffffff;
  --paper: #ffffff;
  --ink: #4c4948;
  --ink-soft: #858585;
  --ink-faint: #adadad;
  --line: #eaeaea;
  --theme-color: #49b1f5;
  --theme-paginator-color: #49b1f5;
  --theme-text-selection-color: #49b1f5;
  --theme-link-color: #49b1f5;
  --theme-meta-color: #858585;
  --theme-hr-color: #eaeaea;
  --theme-toc-color: #49b1f5;
  --blockquote-padding-color: #49b1f5;
  --blockquote-background-color: rgba(73,177,245,.06);
  --scrollbar-color: #49b1f5;
  --shadow-card: 0 3px 8px 6px rgba(7,17,27,.05);
  --shadow-lift: 0 6px 16px 8px rgba(7,17,27,.09);
}
[data-theme="dark"] {
  --card-bg: #121212;
  --paper: #1c1c1c;
  --ink: #e8e6e3;
  --ink-soft: #9a9a9a;
  --ink-faint: #6a6a6a;
  --line: #2a2a2a;
  --theme-color: #80c8f8;
  --theme-paginator-color: #80c8f8;
  --theme-text-selection-color: #80c8f8;
  --theme-link-color: #80c8f8;
  --theme-meta-color: #9a9a9a;
  --theme-hr-color: #2a2a2a;
  --theme-toc-color: #80c8f8;
  --blockquote-padding-color: #80c8f8;
  --blockquote-background-color: rgba(128,200,248,.08);
  --scrollbar-color: #80c8f8;
  --shadow-card: 0 3px 8px 6px rgba(0,0,0,.3);
  --shadow-lift: 0 6px 16px 8px rgba(0,0,0,.45);
}

#body-wrap {
  --font-color: var(--ink);
  --default-text-color: var(--ink);
  --card-bg: var(--card-bg);
  background: transparent; /* 让 #web_bg 的背景图透出来 */
}
[data-theme="dark"] #body-wrap { background: transparent; }

/* ============ 页眉透明：header 与 body 共用 #web_bg 一张背景图 ============ */
/* 只作用于没有单独配图的页眉（有 style 内联背景图的页面不受影响） */
#page-header:not([style*="background-image"]) {
  background: transparent !important;
}
/* 去掉无配图页眉的主题遮罩层（::before 深色蒙版），保证图片完全连贯 */
#page-header:not([style*="background-image"])::before {
  display: none !important;
}

/* 移除旧噪声层（改用主题 #web_bg 背景图）*/
#body-wrap::before { display: none; }

/* ============ 字体：系统字体（onektas 用系统栈）============ */
/* 注意：排除 <i> 元素，否则 Font Awesome / Remix Icon 的图标字体会被覆盖导致图标空白 */
#body-wrap,
#body-wrap *:not(i),
.recent-post-info,
#aside-content,
#footer,
blockquote {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue",
               "PingFang SC", "Microsoft YaHei", "Noto Sans SC", sans-serif !important;
}
/* 标题保留宋体（古风骨架） */
#article-container .post-content h1,
#article-container .post-content h2,
#article-container .post-content h3,
#site-title,
.hero-greeting .greeting-time,
.strip-title,
.cloud-title {
  font-family: "Noto Serif SC", "Songti SC", "STSong", serif !important;
}
figure.highlight, pre, code, .aplayer *, kbd {
  font-family: "JetBrains Mono", "SF Mono", Consolas, Menlo, monospace !important;
}

/* ============ 导航栏 ============ */
#nav-header,
.navbar {
  background: rgba(255,255,255,.9) !important;
  backdrop-filter: blur(10px);
  border-bottom: none;
  box-shadow: 0 1px 8px rgba(7,17,27,.04);
}
[data-theme="dark"] #nav-header,
[data-theme="dark"] .navbar {
  background: rgba(18,18,18,.9) !important;
}
#nav .site-page,
.navbar .nav-links a {
  font-weight: 500;
  letter-spacing: .02em;
  color: var(--ink);
}
/* 下划线：onektas 风格的蓝色短线 */
#nav .site-page:not(.child)::after {
  left: 50% !important;
  width: 0 !important;
  height: 2px !important;
  background-color: var(--theme-color) !important;
  transform: translateX(-50%);
  transition: width .3s ease-in-out !important;
}
#nav .site-page:not(.child):hover::after,
#nav .site-page:not(.child).select::after {
  width: 40% !important;
}

/* ============ 卡片：无边框纯阴影（onektas 核心特征）============ */
#aside-content .card-widget,
.layout-pages .card-page,
#pagination,
#article-container {
  background: #fff;
  border: none;
  box-shadow: var(--shadow-card);
}
[data-theme="dark"] #aside-content .card-widget,
[data-theme="dark"] .layout-pages .card-page,
[data-theme="dark"] #pagination,
[data-theme="dark"] #article-container {
  background: #121212;
  box-shadow: 0 3px 8px 6px rgba(0,0,0,.3);
}
/* sticky 粘性区限高保持 */
#aside-content .sticky_layout {
  max-height: calc(100vh - 120px);
  overflow-y: auto;
  padding-right: 2px;
  display: flex;
  flex-direction: column;
}
/* flex 容器限高时子项默认收缩会被压扁，禁止收缩保持自然高度 */
#aside-content .sticky_layout > .card-widget {
  flex-shrink: 0;
}
#aside-content .sticky_layout::-webkit-scrollbar { width: 4px; }
#aside-content .sticky_layout::-webkit-scrollbar-thumb {
  background: rgba(73,177,245,.35); border-radius: 2px;
}

/* ============ 文章页 ============ */
#article-container .post-content {
  line-height: 1.9;
  letter-spacing: .01em;
  color: var(--ink);
}
#article-container .post-content h1,
#article-container .post-content h2,
#article-container .post-content h3,
#article-container .post-content h4 {
  letter-spacing: .03em;
  border-bottom: none;
  color: var(--ink);
}
#article-container .post-content h1:before,
#article-container .post-content h2:before {
  color: var(--theme-color);
}
blockquote {
  border-left: 3px solid var(--theme-color) !important;
  background: var(--blockquote-background-color) !important;
  font-style: normal;
  color: var(--ink-soft);
}
[data-theme="dark"] blockquote {
  border-left: 3px solid var(--theme-color) !important;
}

/* ============ 按钮/标签 ============ */
.button--primary,
button.btn-primary,
#aside-content .card-info .card-info-btn {
  background: var(--theme-color) !important;
  border-color: var(--theme-color) !important;
  border-radius: 6px;
}
.button--primary:hover,
button.btn-primary:hover {
  background: #2a9bec !important;
  border-color: #2a9bec !important;
}
[data-theme="dark"] .button--primary,
[data-theme="dark"] button.btn-primary {
  background: var(--theme-color) !important;
  border-color: var(--theme-color) !important;
}
.tag-cloud-list a {
  border: 1px solid rgba(73,177,245,.3) !important;
  background: rgba(73,177,245,.05) !important;
}
.tag-cloud-list a:hover {
  background: rgba(73,177,245,.15) !important;
}

/* ============ 滚动条：onektas 蓝色渐变 ============ */
::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-track {
  background-color: rgba(73,177,245,.15);
  border-radius: 1em;
}
::-webkit-scrollbar-thumb {
  background-color: #49b1f5;
  background-image: -webkit-linear-gradient(45deg, rgba(255,255,255,.4) 25%, transparent 25%, transparent 50%, rgba(255,255,255,.4) 50%, rgba(255,255,255,.4) 75%, transparent 75%, transparent);
  border-radius: 1em;
}
[data-theme="dark"] ::-webkit-scrollbar-thumb { background-color: #80c8f8; }
[data-theme="dark"] ::-webkit-scrollbar-track { background-color: rgba(128,200,248,.12); }

/* ============ 页脚 ============ */
/* 主题 #footer>* 用 --light-grey(#eee) 配深色页脚，白底下不可见，强制深字 */
#footer {
  background: #fff !important;
  border-top: none;
  color: #4c4948 !important;
}
#footer > *,
#footer > * > *,
#footer a,
#footer span,
#footer div {
  color: #4c4948 !important;
}
[data-theme="dark"] #footer {
  background: #121212 !important;
  color: #9a9a9a !important;
}
[data-theme="dark"] #footer > *,
[data-theme="dark"] #footer > * > *,
[data-theme="dark"] #footer a,
[data-theme="dark"] #footer span,
[data-theme="dark"] #footer div {
  color: #9a9a9a !important;
}

/* 选中文字：蓝底白字 */
::selection {
  background: rgba(73,177,245,.85);
  color: #fff;
}
[data-theme="dark"] ::selection {
  background: rgba(128,200,245,.85);
}

@media (max-width: 768px) {
  #article-container .post-content { letter-spacing: 0; }
}

/* ============ 背景图上的文字可读性 ============ */
/* 页眉大标题/副标题：白色字加深投影，压在亮部也不发虚 */
#site-title {
  text-shadow: 0 2px 14px rgba(0,0,0,.5), 0 1px 3px rgba(0,0,0,.55) !important;
}
#site-subtitle, #subtitle {
  text-shadow: 0 1px 10px rgba(0,0,0,.55), 0 1px 3px rgba(0,0,0,.5) !important;
}
#scroll-down .scroll-down-effects {
  text-shadow: 0 1px 8px rgba(0,0,0,.55) !important;
}
/* 顶部导航：深色字配浅色投影，压在亮部暗部都可读 */
#nav .site-name, #nav .menus_items .menus_item a, #nav .nav-site-title {
  text-shadow: 0 1px 5px rgba(255,255,255,.7);
}
/* “最近更新”标题行：半透明白胶囊底 */
.recent-strip .strip-head {
  background: rgba(255,255,255,.78);
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255,255,255,.6);
  border-radius: 999px;
  padding: .4rem 1.1rem;
}
[data-theme="dark"] .recent-strip .strip-head {
  background: rgba(18,18,18,.55);
  border-color: rgba(255,255,255,.12);
}
/* 分页按钮：半透明底，压图可读 */
#pagination .page-number, #pagination .space, #pagination .extend {
  background: rgba(255,255,255,.78);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}
[data-theme="dark"] #pagination .page-number, [data-theme="dark"] #pagination .space, [data-theme="dark"] #pagination .extend {
  background: rgba(18,18,18,.55);
}
#pagination .page-number.current {
  background: #49b1f5 !important;
}
/* 内页大标题（归档/标签/分类）：浅色投影提亮 */
.page-title {
  text-shadow: 0 1px 8px rgba(255,255,255,.85);
}
/* 归档页时间线：白色字 + 深色投影，压图可读 */
.article-sort-title,
.article-sort-item.year {
  color: #fff !important;
  text-shadow: 0 2px 10px rgba(0,0,0,.65);
}
.article-sort-item-title {
  color: #fff !important;
  text-shadow: 0 1px 8px rgba(0,0,0,.65);
}
.article-sort-item-time {
  color: rgba(255,255,255,.85) !important;
  text-shadow: 0 1px 6px rgba(0,0,0,.55);
}

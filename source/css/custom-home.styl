/* ============================================
 * 批次4：首页组件
 * 1. 问候语打字机
 * 2. 最近更新滚动条
 * 3. 首页标签云
 * 4. 分类标签卡片墙
 * 5. 文章卡片重设计（Heo 风格）
 * ============================================ */

/* ===== 1. 问候语打字机 ===== */
.hero-greeting {
  text-align: center;
  padding: 2.5rem 1rem 1.5rem;
  font-family: "Noto Serif SC", "Songti SC", serif;
}
.hero-greeting .greeting-time {
  font-size: 1.6rem;
  font-weight: 700;
  color: var(--theme-color);
  letter-spacing: .08em;
}
.hero-greeting .greeting-sub {
  display: inline-block;
  min-height: 1.8em;
  margin-top: .6rem;
  font-size: .95rem;
  letter-spacing: .12em;
  opacity: .8;
}
.greeting-cursor {
  display: inline-block;
  width: 2px;
  height: 1em;
  vertical-align: -2px;
  background: var(--theme-color);
  animation: cursor-blink .8s step-end infinite;
}
@keyframes cursor-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* ===== 2. 最近更新滚动条 ===== */
.recent-strip {
  margin: 0 auto 1.5rem;
  padding: 0 .5rem;
}
.recent-strip .strip-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: .6rem;
}
.recent-strip .strip-title {
  font-size: .9rem;
  font-weight: 700;
  font-family: "Noto Serif SC", serif;
  color: var(--font-color);
}
.recent-strip .strip-title::before {
  content: "◈ ";
  color: var(--theme-color);
}
.recent-strip .strip-more {
  font-size: .75rem;
  color: var(--theme-color);
  text-decoration: none !important;
  opacity: .8;
}
.recent-strip .strip-more:hover { opacity: 1; }
.recent-scroll {
  display: flex;
  gap: .8rem;
  overflow-x: auto;
  padding: .3rem .1rem .6rem;
  scroll-behavior: smooth;
  scrollbar-width: thin;
  scrollbar-color: rgba(140, 59, 46, .3) transparent;
}
.recent-scroll::-webkit-scrollbar {
  height: 5px;
}
.recent-scroll::-webkit-scrollbar-thumb {
  background: rgba(140, 59, 46, .25);
  border-radius: 3px;
}
.recent-scroll::-webkit-scrollbar-track {
  background: transparent;
}
.recent-item {
  flex: none;
  width: 200px;
  border-radius: .7rem;
  border: 1px solid rgba(140, 59, 46, .15);
  background: rgba(245, 241, 232, .7);
  overflow: hidden;
  text-decoration: none !important;
  transition: all .25s ease;
}
.recent-item:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 18px -8px rgba(60, 30, 20, .3);
  border-color: rgba(140, 59, 46, .35);
}
[data-theme="dark"] .recent-item {
  background: rgba(30, 26, 22, .7);
  border-color: rgba(201, 88, 63, .15);
}
[data-theme="dark"] .recent-item:hover {
  border-color: rgba(201, 88, 63, .35);
}
.recent-item .recent-thumb {
  width: 100%;
  height: 100px;
  object-fit: cover;
  display: block;
  background: rgba(140, 59, 46, .06);
}
.recent-item .recent-meta {
  padding: .5rem .6rem;
}
.recent-item .recent-name {
  font-size: .78rem;
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  color: var(--font-color);
}
.recent-item .recent-date {
  font-size: .65rem;
  opacity: .55;
  margin-top: .25rem;
}

/* ===== 3. 首页标签云 ===== */
.home-tag-cloud {
  margin: 0 auto 1.5rem;
  padding: 1rem;
  border-radius: .8rem;
  border: 1px solid rgba(140, 59, 46, .12);
  background: rgba(245, 241, 232, .5);
}
[data-theme="dark"] .home-tag-cloud {
  background: rgba(30, 26, 22, .5);
  border-color: rgba(201, 88, 63, .12);
}
.home-tag-cloud .cloud-title {
  font-size: .9rem;
  font-weight: 700;
  font-family: "Noto Serif SC", serif;
  margin-bottom: .7rem;
}
.home-tag-cloud .cloud-title::before {
  content: "◈ ";
  color: var(--theme-color);
}
.home-tag-cloud .tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: .4rem;
}
.home-tag-cloud .tag-pill {
  display: inline-flex;
  align-items: center;
  gap: .3rem;
  padding: .25rem .8rem;
  font-size: .75rem;
  border-radius: 999px;
  border: 1px solid rgba(140, 59, 46, .25);
  background: rgba(140, 59, 46, .05);
  color: var(--font-color);
  text-decoration: none !important;
  transition: all .2s ease;
}
.home-tag-cloud .tag-pill:hover {
  background: rgba(140, 59, 46, .12);
  border-color: var(--theme-color);
  color: var(--theme-color);
  transform: translateY(-2px);
}
[data-theme="dark"] .home-tag-cloud .tag-pill {
  border-color: rgba(201, 88, 63, .25);
  background: rgba(201, 88, 63, .05);
}
[data-theme="dark"] .home-tag-cloud .tag-pill:hover {
  background: rgba(201, 88, 63, .12);
}
.tag-pill .tag-count {
  font-size: .65rem;
  opacity: .6;
}

/* ===== 4. 分类标签卡片墙 ===== */
.home-category-wall {
  margin: 0 auto 1.5rem;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: .8rem;
}
.cat-card {
  position: relative;
  padding: 1.2rem .9rem;
  border-radius: .8rem;
  border: 1px solid rgba(140, 59, 46, .15);
  background: linear-gradient(135deg, rgba(245, 241, 232, .9), rgba(238, 230, 215, .9));
  text-decoration: none !important;
  overflow: hidden;
  transition: all .25s ease;
}
.cat-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 10px 22px -10px rgba(60, 30, 20, .35);
  border-color: rgba(140, 59, 46, .4);
}
[data-theme="dark"] .cat-card {
  background: linear-gradient(135deg, rgba(30, 26, 22, .9), rgba(38, 33, 28, .9));
  border-color: rgba(201, 88, 63, .15);
}
[data-theme="dark"] .cat-card:hover {
  border-color: rgba(201, 88, 63, .4);
}
.cat-card::after {
  content: "";
  position: absolute;
  right: -20px;
  bottom: -20px;
  width: 70px;
  height: 70px;
  border-radius: 50%;
  background: rgba(140, 59, 46, .06);
}
[data-theme="dark"] .cat-card::after {
  background: rgba(201, 88, 63, .07);
}
.cat-card .cat-name {
  font-size: .95rem;
  font-weight: 700;
  font-family: "Noto Serif SC", serif;
  color: var(--font-color);
  position: relative;
  z-index: 1;
}
.cat-card .cat-count {
  font-size: .7rem;
  opacity: .55;
  margin-top: .2rem;
  position: relative;
  z-index: 1;
}

/* ===== 5. 文章卡片重设计（Heo 风格：大圆角 + 毛玻璃 + 悬浮发光）===== */
#recent-posts .recent-post-item {
  border-radius: 1rem !important;
  border: 1px solid rgba(140, 59, 46, .12) !important;
  background: rgba(245, 241, 232, .75) !important;
  backdrop-filter: blur(8px);
  box-shadow: 0 2px 8px -4px rgba(60, 30, 20, .15) !important;
  transition: all .3s cubic-bezier(.4, 0, .2, 1) !important;
  overflow: hidden;
  margin-bottom: 1.2rem !important;
}
#recent-posts .recent-post-item:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 32px -12px rgba(60, 30, 20, .28) !important;
  border-color: rgba(140, 59, 46, .3) !important;
}
[data-theme="dark"] #recent-posts .recent-post-item {
  background: rgba(30, 26, 22, .75) !important;
  border-color: rgba(201, 88, 63, .12) !important;
}
[data-theme="dark"] #recent-posts .recent-post-item:hover {
  box-shadow: 0 16px 32px -12px rgba(0, 0, 0, .5) !important;
  border-color: rgba(201, 88, 63, .3) !important;
}
/* 封面圆角 */
#recent-posts .post_cover {
  border-radius: 1rem 1rem 0 0 !important;
  overflow: hidden;
}
#recent-posts .post_cover img {
  transition: transform .5s cubic-bezier(.4, 0, .2, 1);
}
#recent-posts .recent-post-item:hover .post_cover img {
  transform: scale(1.05);
}
/* 卡片内标题 */
#recent-posts .recent-post-info .article-title {
  font-family: "Noto Serif SC", "Songti SC", serif !important;
  font-weight: 700 !important;
  transition: color .25s;
}
#recent-posts .recent-post-item:hover .article-title {
  color: var(--theme-color) !important;
}
/* 悬浮发光描边（Heo 标志效果）*/
#recent-posts .recent-post-item::before {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 1rem;
  padding: 1px;
  background: linear-gradient(135deg, rgba(140, 59, 46, .35), transparent 40%, transparent 60%, rgba(140, 59, 46, .35));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  opacity: 0;
  transition: opacity .3s;
  pointer-events: none;
}
#recent-posts .recent-post-item:hover::before {
  opacity: 1;
}
[data-theme="dark"] #recent-posts .recent-post-item::before {
  background: linear-gradient(135deg, rgba(201, 88, 63, .4), transparent 40%, transparent 60%, rgba(201, 88, 63, .4));
}

/* 首页打字机只在首页显示，首页容器统一宽度 */
@media (max-width: 768px) {
  .recent-strip,
  .home-tag-cloud,
  .home-category-wall {
    padding: 0 .8rem;
  }
  .recent-item {
    width: 160px;
  }
}
